# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
sscmex-*.tar

# Temporary files, for example, from tests.
/tmp/


build/
checksum.exs
.nix-*
compile_commands.json


# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml


# ccls related
.ccls-cache
.cache

# Secrets - DO NOT COMMIT
**/secrets.exs
config/secrets.exs
example/config/secrets.exs
example/deps

# Cursor IDE
.cursor


.sisyphus


# built files
priv/*.so
priv/lib/*.so
priv/lib/*.so.*
cmake_build

# Local conversion outputs (large binary models, regenerated on demand
# via scripts/yolov7_pt_to_clean_onnx.py and scripts/build_yolov7_cvimodel.sh)
build_artifacts/

# Python bytecode from running scripts/*.py locally
__pycache__/
*.pyc
