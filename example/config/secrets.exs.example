# WiFi configuration for SG2002 (reCamera) deployment
# Copy this file to secrets.exs and fill in your actual WiFi credentials
# DO NOT commit secrets.exs to git - it is already in .gitignore

use Mix.Config

config :nerves_runtime,
  wifi: %{
    ssid: "YOUR_WIFI_SSID",
    psk: "YOUR_WIFI_PASSWORD",
    # Optional: specify interface if you have multiple WiFi adapters
    # interface: "wlan0"
  }
